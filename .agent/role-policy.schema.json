{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpsAgent Role Policy",
  "type": "object",
  "required": ["version", "roles", "taskPolicies"],
  "properties": {
    "version": { "type": "string" },
    "roles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["actor", "responsibilities"],
        "properties": {
          "actor": { "type": "string" },
          "fallbackActor": { "type": "string" },
          "responsibilities": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        }
      }
    },
    "taskPolicies": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["owner", "executor", "tester", "testStrategist", "reviewer", "humanApprovalRequired"],
        "properties": {
          "owner": { "type": "string" },
          "executor": { "type": "string" },
          "tester": { "type": "string" },
          "testStrategist": { "type": "string" },
          "reviewer": { "type": "string" },
          "humanApprovalRequired": { "type": "boolean" }
        }
      }
    }
  }
}
