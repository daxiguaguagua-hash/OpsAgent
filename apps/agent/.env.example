# ─────────────────────────────────────────────────────────────
# Agent（智能体）端口注册
# ─────────────────────────────────────────────────────────────
# agent 是长驻进程（Mastra 框架），不对外暴露 HTTP 端口。
# 但它需要知道以下基础设施端点才能拉取可观测性数据与错误上下文：
#
#   backend       = 8000（agent 不直连，由前端/外部调用）
#   GlitchTip API = 8001（host 端；SENTRY_API_ENDPOINT 指向这里）
#   Prometheus    = 9090（PROMETHEUS_URL）
#   Loki          = 3100（LOKI_URL）
#   Tempo         = 3200（agent 通过 OTEL endpoint 4318 上报 trace）
#
# 最佳实践（生产环境 / 多服务并存）：
#   使用 Nginx 或 Traefik 做反向代理，对外只暴露 80/443，
#   按域名 / 路径分发到内部端口，各服务不再直接暴露 host 端口。
#   演进节奏见 docs/decisions/0009-port-allocation-strategy.md。
# ─────────────────────────────────────────────────────────────

MODEL_PROVIDER=mock
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
ALIBABA_API_KEY=sk-your-alibaba-api-key-here
OLLAMA_MODEL=qwen2.5-coder:14b
CLOUD_MODEL=gpt-4o

PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100

# Sentry/GlitchTip（sentry-tool 运行时读取，ADR-0007 / ADR-0006）
# GlitchTip host 端口是 8001（backend 占 8000，必须错开）。
# SENTRY_API_ENDPOINT=http://localhost:8001/api/0
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
