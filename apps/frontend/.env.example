# ─────────────────────────────────────────────────────────────
# Frontend（前端）端口注册
# ─────────────────────────────────────────────────────────────
# VITE_SERVER_URL：前端直连的 backend HTTP 端口（默认 8000）。
# Vite dev server 本身固定跑在 3001（见 apps/frontend/vite.config.ts）。
#
# 最佳实践（生产环境 / 多服务并存）：
#   使用 Nginx 或 Traefik 做反向代理，对外只暴露 80/443，
#   按域名 / 路径分发到内部端口（如 /api → backend，/sentry → GlitchTip），
#   各服务不再直接暴露 host 端口，从根本上消除端口冲突。
#   演进节奏见 docs/decisions/0009-port-allocation-strategy.md。
#
# 当前端口分配（开发期临时方案）：
#   backend     = 8000
#   frontend    = 3001（Vite dev server）
#   GlitchTip   = 8001（host 端；容器内仍是 8000）
#   Grafana     = 3000
#   Prometheus  = 9090
#   Loki        = 3100
#   Tempo       = 3200
#   OTel gRPC   = 4317
#   OTel HTTP   = 4318
#   PostgreSQL  = 5432
#   Redis       = 6379
# ─────────────────────────────────────────────────────────────
VITE_SERVER_URL=http://localhost:8000

# Sentry Source Map 上传凭证（M4 Phase B / ADR-0006）
# 在 sentry.io Developer Settings → Personal Tokens 创建
# 权限：Project: Admin / Release: Admin / Organization: Read
# 详见 docs/lessons/2026-06-16-Sentry的TOKEN配置.md
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── GlitchTip 凭证（可选，详见 apps/frontend/.env 示例） ──
# 注意 GlitchTip host 端口是 8001（不是 8000）。
# SENTRY_URL=http://localhost:8001
# VITE_SENTRY_DSN=http://<public-key>@localhost:8001/1
