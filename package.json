{
  "name": "opsagent",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "check-types": "turbo check-types",
    "task:create": "node --experimental-strip-types packages/workflow-gates/src/taskCli.ts create",
    "task:show": "node --experimental-strip-types packages/workflow-gates/src/taskCli.ts show",
    "task:next": "node --experimental-strip-types packages/workflow-gates/src/taskCli.ts next",
    "task:start": "node --experimental-strip-types packages/workflow-gates/src/taskCli.ts start",
    "task:review": "node --experimental-strip-types packages/workflow-gates/src/taskCli.ts review",
    "task:finish": "node --experimental-strip-types packages/workflow-gates/src/taskCli.ts finish",
    "task:execute": "node --experimental-strip-types packages/workflow-gates/src/taskCli.ts execute",
    "task:status": "node --experimental-strip-types packages/workflow-gates/src/taskCli.ts status",
    "task:handoff": "node --experimental-strip-types packages/workflow-gates/src/taskCli.ts handoff",
    "task:scope": "node --experimental-strip-types packages/workflow-gates/src/taskCli.ts scope",
    "task:criteria": "node --experimental-strip-types packages/workflow-gates/src/taskCli.ts criteria",
    "task:test-plan": "node --experimental-strip-types packages/workflow-gates/src/taskCli.ts test-plan",
    "task:verify-command": "node --experimental-strip-types packages/workflow-gates/src/taskCli.ts verify-command",
    "task:test-impact": "node --experimental-strip-types packages/workflow-gates/src/taskCli.ts test-impact",
    "task:test-approve": "node --experimental-strip-types packages/workflow-gates/src/taskCli.ts test-approve",
    "task:evidence": "node --experimental-strip-types packages/workflow-gates/src/taskCli.ts evidence",
    "task:validate": "node --experimental-strip-types packages/workflow-gates/src/taskCli.ts validate",
    "task:close": "node --experimental-strip-types packages/workflow-gates/src/taskCli.ts close",
    "dev:frontend": "turbo -F frontend dev",
    "dev:backend": "turbo -F backend dev",
    "dev:agent": "turbo -F @opsagent/agent dev",
    "compose:config": "docker compose config",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "db:push": "turbo -F @opsagent/db db:push",
    "db:studio": "turbo -F @opsagent/db db:studio",
    "db:generate": "turbo -F @opsagent/db db:generate",
    "db:migrate": "turbo -F @opsagent/db db:migrate",
    "db:start": "turbo -F @opsagent/db db:start",
    "db:watch": "turbo -F @opsagent/db db:watch",
    "db:stop": "turbo -F @opsagent/db db:stop",
    "db:down": "turbo -F @opsagent/db db:down"
  },
  "dependencies": {
    "@opsagent/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@opsagent/config": "workspace:*",
    "@types/node": "catalog:",
    "turbo": "^2.8.12",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.33.2"
}
