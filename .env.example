# Backend（后端）
PORT=8000
CORS_ORIGIN=http://localhost:3001
DATABASE_URL=postgresql://postgres:password@localhost:5432/opsagent
REDIS_URL=redis://localhost:6379
LOG_FILE_PATH=logs/backend.jsonl
OTEL_TRACES_ENABLED=true
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces

# Grafana（可观测性可视化平台）
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_DEFAULT_LANGUAGE=zh-Hans

# Frontend（前端）
VITE_SERVER_URL=http://localhost:8000
# 错误监控：sentry（默认）/ glitchtip（Phase B 兜底）/ custom（自研 SDK，教学用）
VITE_ERROR_TRACKING_PROVIDER=sentry
# Sentry SaaS（Phase A）：创建项目后在 sentry.io 复制 DSN 粘贴到这里
VITE_SENTRY_DSN=
# Sentry Auth Token：Source Map 上传用（Phase B 才需要，Phase A 留空即可）
SENTRY_AUTH_TOKEN=
# GlitchTip 自建（Phase B）：切到 glitchtip 后填这里的 DSN，前端代码零改动
# VITE_GLITCHTIP_DSN=http://<key>@localhost:8000/1

# Agent（智能体）
MODEL_PROVIDER=mock
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
ALIBABA_API_KEY=sk-your-alibaba-api-key-here
OLLAMA_MODEL=qwen2.5-coder:14b
CLOUD_MODEL=gpt-4o
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100

# GitLab（企业代码托管平台，M5 企业模拟模式预留）
GITLAB_EXTERNAL_URL=http://localhost:8929
GITLAB_HTTP_PORT=8929
GITLAB_SSH_PORT=2224
